# The example runs with no real key: dev.mjs fills these in when they are unset.
# Against the real API, set the application key from the console and remove the base URL.
ANYBIO_GOVERN_KEY=
ANYBIO_GOVERN_APPLICATION=care-companion-example
ANYBIO_GOVERN_BASE_URL=http://localhost:8787

# Mock server behaviour (see examples/mock-server/server.mjs)
GOVERN_MOCK_MODE=enforce
GOVERN_MOCK_PROHIBITED=cure

# Only needed if you browse the example as something other than localhost, for
# example a dev box you reach by hostname. Without this the dev server refuses
# to serve its own client bundle and the send button stays disabled.
# Comma-separated hosts, no scheme or port.
GOVERN_EXAMPLE_DEV_ORIGINS=
