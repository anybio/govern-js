{
  "name": "govern-example-vercel-ai-chatbot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A minimal Next.js app-router chat page with the AnyBio Govern middleware on the model, running against the mock server.",
  "scripts": {
    "dev": "node dev.mjs",
    "dev:next": "next dev -p 3000",
    "mock": "node ../mock-server/server.mjs",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.108",
    "@anybio/govern": "link:../..",
    "ai": "^7.0.105",
    "next": "^16.3.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^4.0.17",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.9.0"
  }
}
